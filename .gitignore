# Stage 1 generated artifacts that must NOT be committed (size / sensitivity).
# Keep small text/JSON/MD outputs only.

# TensorRT-LLM source clone (large; pinned upstream, not our code)
external/

# Engines, model weights, workspace
engines/
models/
trtllm_workspace/

# Profiling raw captures (large binaries)
*.nsys-rep
*.ncu-rep
*.qdrep
*.qdstrm
profiles/**/*.nsys-rep
profiles/**/*.ncu-rep
profiles/**/*.sqlite

# trtllm-bench build artifacts dropped at the workdir root
model.cache

# Per-iteration jsonl benchmark logs (multi-MB each); the summary JSON is enough
results/stage1/benchmark_raw/*_iteration.jsonl

# trtllm-serve /metrics drain dump (multi-MB, regenerable; we keep derived summary)
results/stage1/benchmark_raw/trtllm_serve_metrics_after_streaming.json

# Docker pull / image probe transcripts that change every run
logs/stage0/docker_pull_trtllm.log

# Python
__pycache__/
*.pyc
.venv/
.env

# Editor / OS
.vscode/
.idea/
.DS_Store

# Claude Code session-local state
.claude/
